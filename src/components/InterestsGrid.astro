---
import InterestCard from './InterestCard.astro'

// Interest definitions — edit descriptions here to personalise
const interests = [
  {
    tag:   'Passion 01',
    name:  'Technology',
    color: '#2563EB',
    desc:  'Fascinated by how technology reshapes the world — from AI to the devices we carry. Always watching what\'s next on the horizon.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <rect x="2" y="3" width="20" height="14" rx="2"/>
             <path d="M8 21h8M12 17v4"/>
           </svg>`,
  },
  {
    tag:   'Passion 02',
    name:  'Development',
    color: '#16A34A',
    desc:  'There\'s magic in turning ideas into products. Building software is equal parts craft, logic, and stubbornness — I love every bit of it.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <polyline points="16 18 22 12 16 6"/>
             <polyline points="8 6 2 12 8 18"/>
           </svg>`,
  },
  {
    tag:   'Passion 03',
    name:  'Photography',
    color: '#DB2777',
    desc:  'Seeing the world through a lens changes how you look at everything. Chasing light, moments, and the stories hidden in plain sight.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
             <circle cx="12" cy="13" r="4"/>
           </svg>`,
  },
  {
    tag:   'Passion 04',
    name:  'Travel',
    color: '#EA580C',
    desc:  'New places, new people, new perspective. The world is endlessly surprising and travel is the best way to remind yourself of that.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <circle cx="12" cy="12" r="10"/>
             <line x1="2" y1="12" x2="22" y2="12"/>
             <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
           </svg>`,
  },
  {
    tag:   'Passion 05',
    name:  'Whisky',
    color: '#9333EA',
    desc:  'A good dram is a conversation in a glass. Smoky, peaty, sherried — the world of whisky is a rabbit hole worth every sip of exploration.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M8 2h8l1 7H7L8 2z"/>
             <path d="M7 9c0 7 3 11 5 13 2-2 5-6 5-13"/>
             <line x1="9" y1="14" x2="15" y2="14"/>
           </svg>`,
  },
  {
    tag:   'Passion 06',
    name:  'Family',
    color: '#DC2626',
    desc:  'At the end of the day, it\'s all about the people you come home to. Family is my anchor, my motivation, and my greatest adventure.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
             <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
           </svg>`,
  },
]
---

<section id="interests">
  <div class="section">
    <div class="reveal">
      <div class="section-label">The good stuff</div>
      <h2 class="section-title">What makes<br />me tick</h2>
      <p class="section-subtitle">Six passions. One life. Endlessly connected.</p>
    </div>

    <div class="interests-grid">
      {interests.map((item) => (
        <div class="reveal">
          <InterestCard
            tag={item.tag}
            name={item.name}
            description={item.desc}
            color={item.color}
          >
            <Fragment set:html={item.icon} />
          </InterestCard>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 56px;
  }
</style>
