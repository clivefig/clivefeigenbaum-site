---
// Hero section — no external props needed for v1
---

<section class="hero">
  <!-- Decorative SVG rings behind photo -->
  <svg class="hero-rings" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="250" cy="250" r="200" fill="none" stroke="var(--border)" stroke-width="1"/>
    <circle cx="250" cy="250" r="160" fill="none" stroke="var(--border)" stroke-width="1"/>
    <circle
      class="ring-accent"
      cx="250" cy="250" r="230"
      fill="none"
      stroke="var(--accent-lt)"
      stroke-width="1"
      stroke-dasharray="8 14"
    />
  </svg>

  <div class="photo-wrap reveal">
    <img src="/assets/profile.jpg" alt="Clive Feigenbaum" width="160" height="160" />
    <span class="status-badge">Building something cool</span>
  </div>

  <p class="hero-eyebrow reveal">Welcome to my corner of the internet</p>

  <h1 class="reveal">
    Hi, I'm <em>Clive</em>.<br />
    Nice to meet you.
  </h1>

  <p class="hero-tagline reveal">
    <strong>I am a Customer focused specialist.</strong> Working in the world of SAAS applications and looking to make a difference. A wannabe <strong>photographer</strong> - much to my wife's dismay.<br> A <strong>whisky</strong> sipper who will happily have a wee dram anywhere in the world.<br />A builder of things who is also a full-time curious human.
  </p>

  <div class="cta-group reveal">
    <a href="#interests" class="btn-primary">Explore My World</a>
    <a
      href="https://www.linkedin.com/in/clive-feigenbaum-israel/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-ghost"
    >
      LinkedIn
    </a>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    Scroll
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 80px;
  }

  /* Decorative rings */
  .hero-rings {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 500px; height: 500px;
    pointer-events: none;
  }
  .ring-accent {
    transform-origin: 250px 250px;
    animation: spin-slow 30s linear infinite;
  }
  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }

  /* Profile photo */
  .photo-wrap {
    position: relative;
    margin-bottom: 32px;
    display: inline-block;
  }
  .photo-wrap img {
    width: 160px; height: 160px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 4px solid var(--surface);
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }
  .status-badge {
    position: absolute;
    bottom: 4px; right: -4px;
    background: var(--accent);
    color: var(--navy);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 100px;
    border: 3px solid var(--bg);
    white-space: nowrap;
  }

  /* Text */
  .hero-eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  h1 {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    color: var(--navy);
    margin-bottom: 20px;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero-tagline {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }
  .hero-tagline strong { color: var(--text); }

  /* CTA */
  .cta-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute;
    bottom: 32px; left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    animation: bounce 2.5s ease infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* ─── Mobile ────────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      padding: 100px 20px 72px;
      min-height: 100svh; /* use svh to account for mobile browser chrome */
    }

    /* Scale rings down so they don't bleed off-screen */
    .hero-rings {
      width: 320px;
      height: 320px;
    }

    /* Shrink photo slightly on small screens */
    .photo-wrap img {
      width: 130px;
      height: 130px;
    }

    /* Keep badge inside the viewport */
    .status-badge {
      font-size: 0.65rem;
      padding: 4px 10px;
      right: -8px;
    }

    /* Buttons stack nicely on narrow screens */
    .cta-group {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .cta-group a {
      width: 100%;
      max-width: 280px;
      text-align: center;
    }

    /* Hide scroll hint on mobile — not needed with short viewport */
    .scroll-hint {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .hero-rings { display: none; } /* hide on very small phones to avoid any overflow */
  }
</style>
